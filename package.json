{
  "name": "codex-trace",
  "version": "0.1.2",
  "description": "Local web UI for inspecting Codex session traces, tool calls, and subagents.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HughLee824/codex-trace.git"
  },
  "bin": {
    "codex-trace": "bin/codex-trace.js"
  },
  "files": [
    "bin",
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "serve": "node --experimental-strip-types src/cli.ts serve",
    "reindex": "node --experimental-strip-types src/cli.ts reindex",
    "doctor": "node --experimental-strip-types src/cli.ts doctor",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "codex",
    "trace",
    "jsonl",
    "sessions",
    "observability",
    "cli",
    "local-first"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "typescript": "^6.0.3"
  }
}
